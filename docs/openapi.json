          {
            "name": "cuisine",
            "required": false,
            "in": "query",
            "description": "Cuisine slug, e.g. pizza",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "recommended",
                "rating",
                "delivery_time",
                "delivery_fee"
              ]
            }
          },
          {
            "name": "openNow",
            "required": false,
            "in": "query",
            "description": "Only restaurants that are open now",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "hasDiscount",
            "required": false,
            "in": "query",
            "description": "Only restaurants with discounted dishes",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
