  "info": {
    "title": "Sofreh API",
    "description": "REST API for the Sofreh food-delivery platform. Authenticate with POST /auth/otp/request and /auth/otp/verify, then send `Authorization: Bearer <accessToken>`. Money values are integer toman; image fields are paths relative to the API origin (e.g. /uploads/abc.webp).",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "09121111111",
            "description": "Iranian mobile number (Persian digits and +98 are accepted)"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "09121111111"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9۰-۹]{5}$",
            "example": "12345",
            "description": "5-digit code received by SMS"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "سارا محمدی"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateAddressDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "خانه"
          },
          "details": {
            "type": "string",
            "example": "تهران، سعادت‌آباد، خیابان سرو غربی، پلاک ۱۲، واحد ۴"
          },
          "lat": {
            "type": "number",
            "example": 35.7801
          },
          "lng": {
            "type": "number",
            "example": 51.3762
          }
        },
        "required": [
          "title",
          "details"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "ValidateDiscountDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 30,
            "example": "WELCOME"
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "description": "Food total after item discounts, before delivery",
            "example": 450000
          }
        },
        "required": [
          "code",
          "amount"
        ]
      },
      "OrderLineDto": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "number",
            "example": 12
          },
          "quantity": {
            "type": "number",
            "minimum": 1,
            "maximum": 20,
            "example": 2
          }
        },
        "required": [
          "menuItemId",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "restaurantId": {
            "type": "number",
            "example": 1
          },
          "items": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineDto"
            }
          },
          "addressId": {
            "type": "number",
            "description": "One of the user's saved addresses (or send addressText)"
          },
          "addressText": {
            "type": "string",
            "minLength": 5,
            "maxLength": 250,
            "example": "تهران، ونک، خیابان ملاصدرا، پلاک ۸"
          },
          "paymentMethod": {
            "enum": [
              "ONLINE",
              "CASH"
            ],
            "type": "string"
          },
          "discountCode": {
            "type": "string",
            "maxLength": 30,
            "example": "WELCOME"
          },
          "note": {
            "type": "string",
            "maxLength": 200,
            "example": "زنگ واحد ۴ خراب است"
          }
        },
        "required": [
          "restaurantId",
          "items",
          "paymentMethod"
        ]
      },
      "ReviewDto": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "comment": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "rating"
        ]
      },
      "UpdateOrderStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "PENDING",
              "CONFIRMED",
              "PREPARING",
              "DELIVERING",
              "DELIVERED",
              "CANCELLED"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "RestaurantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "example": "پیتزا پارسی"
          },
          "slug": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "example": "pizza-parsi",
            "description": "URL name: lowercase letters, digits and dashes"
          },
          "description": {
            "type": "string",
            "maxLength": 400
          },
          "logo": {
            "type": "string",
            "nullable": true,
            "example": "/uploads/logo.webp"
          },
          "cover": {
            "type": "string",
            "nullable": true,
            "example": "/uploads/cover.webp"
          },
          "address": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "deliveryFee": {
            "type": "number",
            "minimum": 0,
            "example": 25000
          },
          "minOrder": {
            "type": "number",
            "minimum": 0,
            "example": 150000
          },
          "deliveryTimeMin": {
            "type": "number",
            "minimum": 5,
            "maximum": 180,
            "example": 25
          },
          "deliveryTimeMax": {
            "type": "number",
            "minimum": 5,
            "maximum": 240,
            "example": 40
          },
          "isOpen": {
            "type": "boolean",
            "default": true
          },
          "isActive": {
            "type": "boolean",
            "default": true
          },
          "cuisineIds": {
            "maxItems": 5,
            "description": "Cuisine IDs",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "name",
          "slug",
          "address",
          "deliveryFee",
          "minOrder",
          "deliveryTimeMin",
          "deliveryTimeMax"
        ]
      },
