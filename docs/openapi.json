            "example": 40
          },
          "isOpen": {
            "type": "boolean",
            "default": true
          },
          "isActive": {
            "type": "boolean",
            "default": true
          },
          "cuisineIds": {
            "maxItems": 5,
            "description": "Cuisine IDs",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "SectionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "example": "پیتزاها"
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "name"
        ]
      },
      "MenuItemDto": {
        "type": "object",
        "properties": {
          "sectionId": {
            "type": "number"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "پیتزا پپرونی"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 300
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "example": 320000
          },
          "discountPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 90
          },
          "image": {
            "type": "string",
            "nullable": true,
            "example": "/uploads/pizza.webp"
          },
          "isAvailable": {
            "type": "boolean",
            "default": true
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
