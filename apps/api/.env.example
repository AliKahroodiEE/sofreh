NODE_ENV=development
PORT=4100

# docker compose exposes Postgres on 5433 and Redis on 6380 for local development
DATABASE_URL="postgresql://sofreh:sofreh@localhost:5433/sofreh?schema=public"
REDIS_URL="redis://localhost:6380"

# Use long random strings in production
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# When true, the OTP is returned in the API response instead of being sent by SMS.
# Never enable in production.
OTP_DEV_MODE=true

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS="http://localhost:3100,http://localhost:5100"

# Public base URL used to build absolute image URLs
PUBLIC_URL="http://localhost:4100"

# Phone numbers that get the ADMIN role on first login (comma-separated)
ADMIN_PHONES="09120000000"
