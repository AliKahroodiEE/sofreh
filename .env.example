# Settings for `docker compose --profile full up` (copy to .env next to docker-compose.yml).
# Local development of the API uses apps/api/.env instead.

POSTGRES_USER=sofreh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sofreh

# Required. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m

# Public address the browser uses (Nginx). Used for CORS and image URLs.
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Phones that become admins on first login
ADMIN_PHONES=09120000000

# Demo server only: show OTP codes in API responses and load sample data on start.
# OTP_DEV_MODE=true also needs NODE_ENV=development (the API refuses it in production).
NODE_ENV=production
OTP_DEV_MODE=false
SEED_DEMO_DATA=false
